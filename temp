#!/usr/bin/env bash
# ============================================================
# NeurIPS experiment runs — each command in a separate terminal
# ============================================================

# --- PPO Training (saves checkpoints) ---

# Alpha 0.3 (~5 hours)
python main.py --algorithm ppo --gpu --alpha=0.3 --apply_best_params --save_policy_ppo --save_dir=./training_data/NeurIPS_results/0_3

# Alpha 1.0 (~3 hours)
python main.py --algorithm ppo --gpu --alpha=1.0 --apply_best_params --save_policy_ppo --save_dir=./training_data/NeurIPS_results/1_0

# --- MCTS n_iter Scaling Sweeps (5 runs each, ~24-30h per run) ---
# Sweeps n_iter = [100, 200, 300, 400, 500] with best params
# Runs sequentially on one GPU via wandb agent

# Alpha 0.3
python sweep.py --algorithm mcts --alpha=0.3

# Alpha 1.0
python sweep.py --algorithm mcts --alpha=1.0
